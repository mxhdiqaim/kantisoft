# ----------------------------
# PRODUCTION ENVIRONMENT VARIABLES
# ----------------------------
NODE_ENV=production
PORT=5473

# Database Settings
DB_SSL_REQUIRED=boolean_value
DB_CONNECTION_STRING=some_url_value

# Other local env variables
JWT_SECRET=some_value
SESSION_SECRET=some_value

# REDIS
REDIS_HOST=some_value
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PASSWORD_FILE=/run/secrets/redis_password_file# Path to the file containing the redis password